APP_NAME=Digital Event Manager API
API_V1_PREFIX=/api/v1
ENVIRONMENT=local
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=digital_events
DB_ECHO=false

# Email confirmation
EMAIL_CONFIRMATION_SECRET_KEY=your-super-secret-key-for-email-codes

# SMTP configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true